NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (solo servidor). Pegar el JSON completo de la service account
# en una sola linea. En produccion (App Hosting/Cloud Run) no hace falta: se usa
# applicationDefault() automaticamente.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Envio de correo (Gmail SMTP, ver src/lib/email.ts). SMTP_EMAIL_APP_PASSWORD
# es una App Password (myaccount.google.com/apppasswords), NUNCA la contrasena
# normal de la cuenta.
SMTP_EMAIL_USER=
SMTP_EMAIL_APP_PASSWORD=
